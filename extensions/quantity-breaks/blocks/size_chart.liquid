{%- comment -%}
  Size chart — app block.

  Renders a "Sizing Chart" link that opens a modal with inch/cm tables and
  measuring tips. Fonts: no third-party font requests. The heading font is a
  font_picker setting, which Shopify serves from its own CDN via font_face;
  everything else inherits the theme's font.
{%- endcomment -%}
{{ 'size-chart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'size-chart.js' | asset_url }}" defer></script>

{%- assign heading_font = block.settings.heading_font -%}
{{ heading_font | font_face: font_display: 'swap' | prepend: '<style>' | append: '</style>' }}

{%- capture sc_vars -%}
  --sc-accent: {{ block.settings.accent_color }};
  --sc-text: {{ block.settings.text_color }};
  --sc-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
  --sc-heading-weight: {{ heading_font.weight }};
  --sc-heading-style: {{ heading_font.style }};
{%- endcapture -%}

{%- assign sizes = 'XS,S,M,L,XL,XXL' | split: ',' -%}
{%- assign conv_au = '6,8,10,12,14,16' | split: ',' -%}
{%- assign conv_us = '2,4,6,8,10,12' | split: ',' -%}
{%- assign conv_eu = '34,36,38,40,42,44' | split: ',' -%}
{%- assign measure_inch = 'BUST (Widest Part)::31.4-33,33.4-35,35-37,37.4-38.9,39.3-40.9,41.3-42.9##WAIST (Slimmest Part)::24-25.5,25.9-27.5,27.9-29.5,29.9-31.4,32.2-33.4,33.8-35.4##HIPS (Widest Part)::34.6-36.2,36.6-38.1,38.5-40.1,40.5-42.1,42.5-44,44.4-46' | split: '##' -%}
{%- assign measure_cm = 'BUST (Widest Part)::80-84,85-89,90-94,95-99,100-104,105-109##WAIST (Slimmest Part)::61-65,66-70,71-75,76-80,81-85,86-90##HIPS (Widest Part)::88-92,93-97,98-102,103-107,108-112,113-117' | split: '##' -%}
{%- assign units = 'inch|cm' | split: '|' -%}
{%- assign col_span = sizes.size | plus: 1 -%}

<div class="sc-trigger" style="{{ sc_vars | strip_newlines }}" data-sc-block data-sc-id="{{ block.id }}" {{ block.shopify_attributes }}>
  <button type="button" class="sc-link" data-sc-open aria-haspopup="dialog" aria-controls="sc-modal-{{ block.id }}">
    {{- block.settings.link_text -}}
  </button>

  {%- comment -%} Moved to <body> by size-chart.js so no theme ancestor can trap its fixed positioning. {%- endcomment -%}
  <div class="sc-root" data-sc-root data-sc-id="{{ block.id }}" style="{{ sc_vars | strip_newlines }}">
    <div class="sc-overlay" data-sc-close></div>
    <div
      class="sc-modal"
      id="sc-modal-{{ block.id }}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sc-title-{{ block.id }}"
      tabindex="-1"
    >
      <button type="button" class="sc-close" data-sc-close aria-label="Close size guide">&times;</button>

      <div class="sc-body">
        <h2 class="sc-title" id="sc-title-{{ block.id }}">{{ block.settings.title }}</h2>

        <div class="sc-tabs" role="tablist">
          <button type="button" class="sc-tab is-active" role="tab" aria-selected="true" data-sc-unit="inch">INCHES</button>
          <button type="button" class="sc-tab" role="tab" aria-selected="false" data-sc-unit="cm">CM</button>
        </div>

        {%- for unit in units -%}
          {%- if unit == 'inch' -%}
            {%- assign measures = measure_inch -%}
            {%- assign unit_label = 'INCHES' -%}
          {%- else -%}
            {%- assign measures = measure_cm -%}
            {%- assign unit_label = 'CM' -%}
          {%- endif -%}
          <div class="sc-table-wrap" data-sc-panel="{{ unit }}" {% unless forloop.first %}hidden{% endunless %}>
            <table class="sc-table">
              <thead>
                <tr>
                  <th scope="col"><span class="sc-visually-hidden">Region</span></th>
                  {%- for size in sizes -%}<th scope="col">{{ size }}</th>{%- endfor -%}
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">AU/NZ/UK</th>
                  {%- for v in conv_au -%}<td>{{ v }}</td>{%- endfor -%}
                </tr>
                <tr>
                  <th scope="row">USA/CA</th>
                  {%- for v in conv_us -%}<td>{{ v }}</td>{%- endfor -%}
                </tr>
                <tr>
                  <th scope="row">EU</th>
                  {%- for v in conv_eu -%}<td>{{ v }}</td>{%- endfor -%}
                </tr>
                {%- for measure in measures -%}
                  {%- assign parts = measure | split: '::' -%}
                  {%- assign values = parts[1] | split: ',' -%}
                  <tr class="sc-section-row"><th scope="colgroup" colspan="{{ col_span }}">{{ parts[0] }}</th></tr>
                  <tr>
                    <th scope="row">{{ unit_label }}</th>
                    {%- for v in values -%}<td>{{ v }}</td>{%- endfor -%}
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- endfor -%}

        <h3 class="sc-subheading">How to Measure</h3>
        <ul class="sc-tips">
          <li><strong>Bust:</strong> Measure around the fullest part of your bust.</li>
          <li><strong>Waist:</strong> Measure around the narrowest part of your waist.</li>
          <li><strong>Hips:</strong> Measure around the fullest part of your hips.</li>
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Size chart",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Sizing Chart (Click to View)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Modal heading",
      "default": "Sizing Guide"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Served from Shopify's font library, so no third-party font requests.",
      "default": "assistant_n7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#eb0069"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ]
}
{% endschema %}
